# Copia este archivo a .env y llena los valores. .env NUNCA se commitea.

NODE_ENV=development
# 0 = puerto libre aleatorio (lo usa Electron); en desarrollo usa 3000
PORT=3000
HOST=127.0.0.1

# MongoDB Atlas: incluye el nombre de la base de datos (/pos) en la URI
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/pos?retryWrites=true&w=majority

# Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<secreto-aleatorio-de-al-menos-32-caracteres>
JWT_EXPIRES_IN=12h

# Orígenes permitidos separados por coma (Electron con file:// envía "null" y siempre se permite)
CORS_ORIGINS=http://localhost:4200

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
